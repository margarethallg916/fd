# ============================================
# Application Settings
# ============================================
DEBUG=false
DEBUG_STREAM_EVENTS=false  # dump 所有 LangChain astream_events 原始事件到 logs/ 目录 (JSONL)
HOST=0.0.0.0
PORT=8000
APP_BASE_URL=  # e.g. https://kunxiaozhi.example.com — 文件 URL 固定前缀（反向代理时必填）
LOG_LEVEL=INFO

# ============================================
# LLM Configuration
# ============================================
LLM_MAX_RETRIES=3
# LLM_MAX_INPUT_TOKENS=  # Optional: context window size for DeepAgent auto-summarization

# ============================================
# Feature Flags
# ============================================
ENABLE_MCP=true
MCP_GLOBAL_CACHE_TTL_SECONDS=900
MCP_GLOBAL_MAX_ENTRIES=100
MCP_USER_CACHE_TTL_SECONDS=900
MCP_USER_CACHE_MAX_ENTRIES=100
MCP_POOL_TTL_SECONDS=900
MCP_POOL_MAX_CONNECTIONS=100
ENABLE_SKILLS=true
ENABLE_SANDBOX=false

# ============================================
# Session Configuration
# ============================================
SESSION_MAX_RUNS_PER_SESSION=100
SESSION_TITLE_MODEL_ID=  # Optional: model card ID for title/recommendation generation (empty = default model)
SESSION_TITLE_PROMPT=请根据用户消息生成一个简洁、准确的会话标题。要求：使用{lang}回复；标题长度控制在5-8个字；只返回标题文本，不要添加Emoji、表情符号、引号或其他特殊格式。用户消息：{message}
WECOM_RUNTIME_MODE=embedded  # embedded | external | disabled
# Initial WeCom network defaults. After an administrator saves the dedicated
# Settings > WeCom Network form, the MongoDB value takes precedence.
WECOM_NETWORK_MODE=direct  # direct | reverse_gateway | forward_proxy
WECOM_WEBSOCKET_URL=wss://openws.work.weixin.qq.com
WECOM_MEDIA_GATEWAY_URL=
WECOM_FORWARD_PROXY_URL=
WECOM_FORWARD_PROXY_USERNAME=
WECOM_FORWARD_PROXY_PASSWORD=
WECOM_CA_BUNDLE_PATH=
WECOM_CONNECT_TIMEOUT_SECONDS=10
WECOM_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=30
WECOM_MEDIA_MAX_BYTES=20971520

ENABLE_MESSAGE_HISTORY=true
SSE_CACHE_TTL=3600  # Redis TTL for SSE events (1 hour)
SESSION_MAX_EVENTS_PER_TRACE=10000
SESSION_EVENT_MONGO_BUFFER_MAX=10000
SESSION_EVENT_TTL_CACHE_MAX=5000

# Event Merger
ENABLE_EVENT_MERGER=true
EVENT_MERGE_INTERVAL=300.0  # Merge interval in seconds (default: 5 minutes)
EVENT_MERGE_BATCH_SIZE=100
EVENT_MERGE_CONCURRENCY=3
EVENT_MERGE_TIMEOUT_SECONDS=120

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=  # Optional: Redis password if authentication is enabled
# Optional Redis Sentinel. Set both HOSTS and MASTER to enable; leave both empty to keep standalone REDIS_URL.
REDIS_SENTINEL_HOSTS=  # Comma-separated sentinel host:port, e.g. s1:26379,s2:26379
REDIS_SENTINEL_MASTER=  # Sentinel monitor name, e.g. mymaster
REDIS_SENTINEL_PASSWORD=  # Optional: Sentinel process password (not the data-node password). Distinct from REDIS_PASSWORD; ARQ fail-closes if the installed arq RedisSettings cannot pass sentinel_kwargs.

# ============================================
# MongoDB Configuration
# ============================================
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=agent_state
MONGODB_USERNAME=  # Optional: MongoDB username
MONGODB_PASSWORD=  # Optional: MongoDB password
MONGODB_AUTH_SOURCE=admin
MONGODB_SESSIONS_COLLECTION=sessions
MONGODB_TRACES_COLLECTION=traces

# Trace event storage rollout (all options below are intentionally commented)
#
# Keep the legacy array path as the default for existing deployments. In this
# mode events are stored in `traces.events[]`; the application remains
# compatible with databases that have not been backfilled yet.
# TRACE_EVENT_WRITE_MODE=legacy
# TRACE_EVENT_READ_MODE=legacy
#
# The immutable event store keeps one MongoDB document per event in a separate
# collection, removing the growing trace-document / `$slice` limitation.
# `dual` writes both legacy and immutable stores; `merge` reads and de-duplicates
# both stores. Dual/merge do not backfill historical events automatically.
# TRACE_EVENT_WRITE_MODE=dual
# TRACE_EVENT_READ_MODE=merge
# MONGODB_TRACE_EVENTS_COLLECTION=trace_events
#
# Do not enable `event_store` reads on an existing database until a dry-run and
# apply backfill have completed, truncated legacy arrays have been reported,
# immutable indexes are ready, and event coverage has been verified. Otherwise
# legacy-only events will be invisible to history reads. A rollback only changes
# these modes back to `legacy` or `merge`; it does not delete trace_events.
# TRACE_EVENT_READ_MODE=event_store
# TRACE_EVENT_WRITE_MODE=event_store
#
# This flag is reserved for an explicit backfill operation. It is currently
# not consumed by an automatic startup job, so setting it alone does not copy
# legacy events or make an event-store cutover safe.
# TRACE_EVENT_BACKFILL_ENABLED=false

# ============================================
# Long-term Storage Configuration (PostgreSQL for LangGraph Store)
# ============================================
ENABLE_POSTGRES_STORAGE=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=langgraph
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10

# ============================================
# Checkpoint Backend Configuration
# ============================================
CHECKPOINT_BACKEND=mongodb  # mongodb or postgres (postgres avoids 16MB limit)
# CHECKPOINT_PG_HOST=       # Leave empty to fallback to POSTGRES_HOST
# CHECKPOINT_PG_PORT=5432
# CHECKPOINT_PG_USER=       # Leave empty to fallback to POSTGRES_USER
# CHECKPOINT_PG_PASSWORD=   # Leave empty to fallback to POSTGRES_PASSWORD
# CHECKPOINT_PG_DB=         # Leave empty to fallback to POSTGRES_DB
# CHECKPOINT_PG_POOL_MIN_SIZE=2
# CHECKPOINT_PG_POOL_MAX_SIZE=10

# ============================================
# MCP Configuration
# ============================================
MCP_ENCRYPTION_SALT=  # Optional: auto-generated if not set (recommended for consistency across restarts)

# ============================================
# Sandbox Configuration
# ============================================
# Supported platforms: daytona, e2b
SANDBOX_PLATFORM=daytona

# Daytona Configuration
DAYTONA_API_KEY=
DAYTONA_SERVER_URL=
DAYTONA_TIMEOUT=180  # Command timeout in seconds (default: 3 minutes)
DAYTONA_IMAGE=  # Optional: sandbox image/snapshot to use for creating sandboxes

# E2B Configuration
E2B_API_KEY=
E2B_TEMPLATE=base  # Sandbox template name
E2B_TIMEOUT=3600  # Sandbox timeout in seconds
E2B_AUTO_PAUSE=true  # Pause sandbox on timeout (preserves state) instead of killing
E2B_AUTO_RESUME=true  # Auto-resume paused sandbox on next activity

# Daytona sandbox lifecycle settings
DAYTONA_AUTO_STOP_INTERVAL=5  # Auto-stop interval in minutes
DAYTONA_AUTO_ARCHIVE_INTERVAL=5  # Auto-archive interval in minutes
DAYTONA_AUTO_DELETE_INTERVAL=1440  # Auto-delete interval in minutes after being archived

# ============================================
# Tracing provider (mutually exclusive)
# none | langsmith | phoenix  — change requires process restart
# ============================================
TRACING_PROVIDER=none

# LangSmith (when TRACING_PROVIDER=langsmith)
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=lamb-agent
LANGSMITH_API_URL=https://api.smith.langchain.com
LANGSMITH_SAMPLE_RATE=1.0

# Phoenix / OpenInference (when TRACING_PROVIDER=phoenix)
# Local: docker compose -f deploy/docker-compose.phoenix.yml up -d
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=lamb-agent
PHOENIX_API_KEY=

# ============================================
# JWT Authentication
# ============================================
JWT_SECRET_KEY=  # Optional: auto-generated if not set (recommended for production)
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_HOURS=24
LOGIN_IDLE_TIMEOUT_HOURS=3
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============================================
# S3 Storage Configuration
# ============================================
S3_ENABLED=false
S3_PROVIDER=aws  # aws, aliyun, tencent, minio, custom
S3_ENDPOINT_URL=  # Required for MinIO and custom providers
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_REGION=us-east-1
S3_BUCKET_NAME=your-bucket-name
S3_CUSTOM_DOMAIN=  # Optional: Custom CDN domain
S3_PATH_STYLE=false  # Required for MinIO
S3_MAX_FILE_SIZE=10485760  # Maximum file size in bytes (default: 10MB)
S3_INTERNAL_UPLOAD_MAX_SIZE=52428800  # Maximum internal upload size in bytes (default: 50MB)
S3_PUBLIC_BUCKET=false
S3_PRESIGNED_URL_EXPIRES=604800  # Presigned URL expiration in seconds (default: 7 days)

# Local Storage (used when S3_ENABLED=false)
LOCAL_STORAGE_PATH=./uploads  # Path for local file storage

# File Upload Limits
FILE_UPLOAD_MAX_SIZE_IMAGE=10  # Maximum image file size in MB
FILE_UPLOAD_MAX_SIZE_VIDEO=100  # Maximum video file size in MB
FILE_UPLOAD_MAX_SIZE_AUDIO=50  # Maximum audio file size in MB
FILE_UPLOAD_MAX_SIZE_DOCUMENT=50  # Maximum document file size in MB
FILE_UPLOAD_MAX_FILES=10  # Maximum number of files per upload

# Personal storage quota (MongoDB remains authoritative; Redis is not the ledger)
USER_STORAGE_ENFORCEMENT_ENABLED=true
USER_STORAGE_DEFAULT_QUOTA_MB=1024
USER_STORAGE_WARNING_PERCENT=80

# ============================================
# User Management
# ============================================
DEFAULT_USER_ROLE=user
ENABLE_REGISTRATION=true

# ============================================
# OA SSO (enterprise portal passwordless login)
# ============================================
OA_SSO_ENABLED=false
OA_SSO_BASE_URL=http://127.0.0.1
OA_SSO_PUBLIC_KEY=
OA_SSO_CHANNEL_ID=aimp
OA_SSO_EMAIL_DOMAIN=ksrcb.com
OA_SSO_AUTO_PROVISION=true
OA_SSO_TIMEOUT_SECONDS=60

# ============================================
# Cloudflare Turnstile (CAPTCHA)
# ============================================
TURNSTILE_ENABLED=false
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_REQUIRE_ON_LOGIN=false
TURNSTILE_REQUIRE_ON_REGISTER=true
TURNSTILE_REQUIRE_ON_PASSWORD_CHANGE=true

# ============================================
# Email Configuration (Resend)
# ============================================
EMAIL_ENABLED=false
RESEND_ACCOUNTS=[]  # JSON array: [{"api_key": "...", "from": "noreply@example.com"}]
PASSWORD_RESET_EXPIRE_HOURS=24
REQUIRE_EMAIL_VERIFICATION=false

# ============================================
# Memory Settings (Cross-session Memory, MongoDB-backed)
# ============================================
ENABLE_MEMORY=false

# Native Memory Settings
# NATIVE_MEMORY_EMBEDDING_MODEL_ID=  # Model card ID (kind=embedding) for vector search; empty = text-only
# NATIVE_MEMORY_STALENESS_DAYS=30
# NATIVE_MEMORY_INDEX_ENABLED=true
# NATIVE_MEMORY_INDEX_CACHE_TTL=300
# NATIVE_MEMORY_MAX_AUTO_RETAIN_PER_DAY=20
# NATIVE_MEMORY_RECALL_MIN_SCORE=0.3  # Minimum relevance score (0.0-1.0) for recalled memories

# ============================================
# Knowledge Base
# ============================================
# Admin-tunable (KB_ENABLED, KB_EMBEDDING_MODEL_ID, KB_RERANK_MODEL_ID, KB_WORKER_CONCURRENCY,
# KB_MAX_FILE_MB, KB_EMBEDDING_BATCH_SIZE) live in the admin settings panel. Environment only:
QDRANT_URL=  # Qdrant server, e.g. http://qdrant:6333. Empty = embedded local mode (QDRANT_LOCAL_PATH)
QDRANT_API_KEY=  # Optional API key for a secured Qdrant server
QDRANT_LOCAL_PATH=data/qdrant  # Embedded Qdrant storage directory (single process only)
KB_ARQ_QUEUE_NAME=kunxiaozhi:kb  # arq queue used by the embedded knowledge base worker
KB_JOB_TIMEOUT_SECONDS=7200  # Max seconds one knowledge base ingest task may run

# ============================================
# Frontend Settings
# ============================================
DEFAULT_AGENT=default
WELCOME_SUGGESTIONS=[{"icon": "🐍", "text": "Create a Python hello world script"}, {"icon": "📁", "text": "List files in the workspace directory"}, {"icon": "📄", "text": "Read the README.md file"}, {"icon": "🔧", "text": "Help me write a shell script"}]

# ============================================
# OAuth Configuration
# ============================================
# Google OAuth
OAUTH_GOOGLE_ENABLED=false
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=

# GitHub OAuth
OAUTH_GITHUB_ENABLED=false
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=

# Apple OAuth
OAUTH_APPLE_ENABLED=false
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=
OAUTH_APPLE_TEAM_ID=
OAUTH_APPLE_KEY_ID=
